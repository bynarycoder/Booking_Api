# The key every request must send in the X-API-Key header (level 2).
API_KEY=clinic-demo-key-2026

# Optional. When set, data is stored in Postgres instead of a local SQLite file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. Where the SQLite file lives (default: ./data/clinic.db).
# SQLITE_PATH=/data/clinic.db

# Optional. Set to 0 to start with an empty appointment list.
# SEED_DEMO_SLOTS=0
